# Teruskan header "Authorization: Bearer <token>" ke PHP.
# Tanpa ini Apache bisa membuangnya, sehingga $_SERVER['HTTP_AUTHORIZATION'] kosong.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
<IfModule mod_version.c>
    <IfVersion >= 2.4.13>
        CGIPassAuth On
    </IfVersion>
</IfModule>
